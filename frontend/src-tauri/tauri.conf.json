{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miniature Catalog",
  "version": "26.10.1",
  "identifier": "com.miniaturecatalog.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "script": "npm run build",
      "wait": true
    },
    "beforeBuildCommand": "npm --prefix .. run version:check && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/": "dist/"
    }
  }
}
